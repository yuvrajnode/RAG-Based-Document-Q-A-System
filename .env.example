# ---- LLM ----------------------------------------------------------------
# Answer synthesis runs on Claude. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
VERBATIM_LLM_MODEL=claude-sonnet-5
VERBATIM_LLM_MAX_TOKENS=1024
VERBATIM_LLM_TEMPERATURE=0.0

# ---- Embeddings ---------------------------------------------------------
# One of: sentence-transformers | voyage | openai | hashing
# "hashing" needs no key or model download and exists so the test suite and a
# first `make run` work on a clean machine. It retrieves poorly. Do not ship it.
VERBATIM_EMBEDDING_PROVIDER=sentence-transformers
VERBATIM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VERBATIM_EMBEDDING_BATCH_SIZE=32
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ---- Vector store -------------------------------------------------------
# chroma (persistent, HNSW) | numpy (flat, exact, dependency-free)
VERBATIM_VECTOR_STORE=chroma
VERBATIM_STORAGE_DIR=./storage

# ---- Chunking -----------------------------------------------------------
VERBATIM_CHUNK_SIZE=900
VERBATIM_CHUNK_OVERLAP=150

# ---- Retrieval ----------------------------------------------------------
VERBATIM_TOP_K=5
VERBATIM_CANDIDATE_K=40
VERBATIM_HYBRID_ALPHA=0.6
VERBATIM_USE_MMR=true
VERBATIM_MMR_LAMBDA=0.65
VERBATIM_MIN_SCORE=0.15

# ---- Server -------------------------------------------------------------
VERBATIM_HOST=0.0.0.0
VERBATIM_PORT=8000
VERBATIM_CORS_ORIGINS=http://localhost:5173
VERBATIM_MAX_UPLOAD_MB=25
